#version 460
// Motion blur, pass 2: the dominant velocity of the 3x3 tile neighbourhood.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D tiles;
layout(set = 0, binding = 1, rg16f) uniform writeonly image2D neighbourhood;
layout(push_constant) uniform Push { ivec2 tileCount; } push;

void main() {
    ivec2 tile = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(tile, push.tileCount))) return;
    vec2 best = vec2(0.0);
    float bestLength = 0.0;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            vec2 v = texelFetch(tiles, clamp(tile + ivec2(x, y), ivec2(0), push.tileCount - 1), 0).rg;
            float l = dot(v, v);
            if (l > bestLength) { bestLength = l; best = v; }
        }
    imageStore(neighbourhood, tile, vec4(best, 0.0, 0.0));
}
