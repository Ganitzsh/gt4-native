#version 460
// The game's 3D scene relit (docs/LIGHTING.md), before its post effects and HUD: the ambient occlusion of
// gsn_ao.comp, blurred over a 4 x 4 block among pixels at about the same distance, darkens the scene in
// linear light; the enhanced grade then gives it more contrast and colour, as a modern renderer's filmic
// response would: a contrast curve on luminance around middle grey with a soft shoulder, vibrance (more for
// muted colours), cool shadows and warm highlights. Targets hold colour / 255 and alpha / 128.
//
// lighting.night (PLAN.md F2, CONTRACTS.md c.3): after the occlusion, before the grade, the view's lamps are added.
// Each pixel's view-space position comes from GT4's Z through the view's own projection and viewport
// (ProjectionData), its normal from the nearer neighbour on each axis; the lights from the clustered light list
// (light_list.glsl); the albedo is estimated as colour / local log-average luminance x 0.18, clamped to [0, 0.9]
// (gsn_night_lum.comp's per-block sums, sampled bilinearly and divided). The sky, pixels whose four blocks have no
// geometry and the rear-view mirror's inset get no added light.
#extension GL_GOOGLE_include_directive : require
#include "light_list.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D scene;
layout(set = 0, binding = 1) uniform sampler2D occlusion;
layout(set = 0, binding = 2) uniform sampler2D depthBuffer;   // GS Z / 2^32
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D result;
layout(std430, set = 0, binding = 4) readonly buffer Header { LightListHeader header; };
layout(std430, set = 0, binding = 5) readonly buffer Lights { GpuLight lights[]; };
layout(std430, set = 0, binding = 6) readonly buffer Cells { ClusterCell cells[]; };
layout(std430, set = 0, binding = 7) readonly buffer Indices { uint indices[]; };
layout(set = 0, binding = 8) uniform sampler2D localLuminance;   // gsn_night_lum.comp: (sum of log luminance, count) per 8 x 8
// N3 step 1: 1 where a skipped item (the lit-road layer) would have drawn (gsn_mask.frag), 0 elsewhere; read only when
// p.skipMasked is 1 (else a stand-in: nothing skipped). For the albedo's stand-in under skipped items (lane F);
// GT4_LIGHT_VIEW=4 shows it.
layout(set = 0, binding = 9) uniform sampler2D skipMask;
// The scene target's side channels (render.scene = hybrid: B8 step 2, B10's lit channel), read only when p.side is 1
// (else stand-ins): the item's view-space normal facing the eye (w: 1 where a blended draw veils the surface) and
// GT4's lit vertex colour (1.0 = 0xFF; the GS modulates the texture by it, 0x80 being 1). Both 0 where no item's
// surface is the pixel's (the sky, untagged draws, a partition's reset).
layout(set = 0, binding = 10) uniform sampler2D sideNormal;
layout(set = 0, binding = 11) uniform sampler2D sideLit;
layout(push_constant) uniform Light {
    vec2 size;
    float aoStrength;   // 0: no occlusion
    float zScale;
    float grade;        // 0: the game's colours; 1: the enhanced grade
    float contrast, vibrance, warmth;
    uint view;          // debugging (GT4_LIGHT_VIEW): 1 the occlusion, 2 the view distance in 10 m bands
    uint aoStep;        // the occlusion's texels per pixel (gsn_ao.comp's step)
    float night;        // 0: no night relight; else its strength
    float skipMasked;   // 1: skipMask holds this Light's skip mask; 0: nothing of it skipped (the mask reads 0);
                        // 2: skipMask holds the scene without GT4's lit-road layer (colour / 255), which `scene` has
    vec2 focal;         // render pixels: x = focal * v / d + centre (v view-space x or y, d the view distance)
    vec2 centre;
    float distanceA;    // view distance = distanceA / (Z + distanceB)
    float distanceB;
    float maxDistance;  // metres: farther is not geometry
    float side;         // 1: sideNormal and sideLit hold this Light's side channels; 0: stand-ins, not read
    vec4 inset;         // the mirror, render pixels (x0, y0, x1, y1, inclusive); x1 < x0: none
    float lampOverlap;  // overlapping street lamps' sum held to this many times the strongest's (<= 1: not held)
    float lampOverBaked;   // our street lamps' light held to this many times GT4's baked light (<= 1: not held)
} p;

const vec3 kLuma = vec3(0.2126, 0.7152, 0.0722);

float distanceAt(ivec2 q) {
    const float z = texelFetch(depthBuffer, q, 0).r * 4294967296.0;
    return z > 0.5 ? p.zScale / z : 1e30;
}

// --- lighting.night -----------------------------------------------------------------------------------------------
// The view distance from GT4's Z through the view's projection: -1 where nothing with depth was drawn.
float nightDistance(ivec2 q) {
    const float z = texelFetch(depthBuffer, q, 0).r * 4294967296.0;
    return z > 0.5 ? p.distanceA / (z + p.distanceB) : -1.0;
}
// GT4's view space (right-handed, +y up, the view looks down -z), metres. Render pixel q's centre is q + 0.5 (the
// projection's window coordinates scaled by the render scale); the GS samples at integer window coordinates, half a GS
// pixel away at 1x: negligible for positions and normals.
vec3 nightPosition(ivec2 q, float d) {
    const vec2 v = (vec2(q) + 0.5 - p.centre) / p.focal * d;
    return vec3(v, -d);
}
// The local log-average luminance (gsn_night_lum.comp), bilinear over the per-block (sum, count) pairs; 0 where the
// four blocks around the pixel hold no geometry.
float nightLocal(ivec2 q) {
    const ivec2 blocks = (ivec2(p.size) + 7) / 8;   // (the image may be larger: it only grows)
    const vec2 f = (vec2(q) + 0.5) / 8.0 - 0.5;
    const ivec2 b = ivec2(floor(f));
    const vec2 t = f - vec2(b);
    vec2 s = vec2(0.0);
    for (int y = 0; y < 2; ++y)
        for (int x = 0; x < 2; ++x) {
            const ivec2 at = clamp(b + ivec2(x, y), ivec2(0), blocks - 1);
            const float w = (x == 1 ? t.x : 1.0 - t.x) * (y == 1 ? t.y : 1.0 - t.y);
            s += texelFetch(localLuminance, at, 0).rg * w;
        }
    return s.y > 1e-3 ? exp(s.x / s.y) : 0.0;
}
// The surface's own colour and normal from the side channels (B10): the pixel over GT4's lit vertex colour is the
// texture, to rounding, since the GS modulates per pixel (texel x colour / 0x80). False where they can't be had: no
// item's surface here, a blended draw veiling it, a vertex colour under the floor (the quotient's noise: 8 of 255 is
// a factor of 1 / 16), or a pixel that reached the target's ceiling (the product was clamped, the quotient is low).
// `gs`: the pixel as the target holds it (colour / 255).
const float kLitFloor = 8.0 / 255.0;
bool sideSurface(ivec2 q, vec3 gs, out vec3 albedo, out vec3 n) {
    if (p.side == 0.0) return false;
    const vec4 normal = texelFetch(sideNormal, q, 0);
    if (normal.w > 0.0 || !(dot(normal.xyz, normal.xyz) >= 0.25)) return false;   // (a NaN normal fails too)
    const vec3 lit = texelFetch(sideLit, q, 0).rgb;
    if (min(lit.r, min(lit.g, lit.b)) < kLitFloor || max(gs.r, max(gs.g, gs.b)) >= 254.5 / 255.0) return false;
    const vec3 texel = clamp(gs / (lit * (255.0 / 128.0)), vec3(0.0), vec3(1.0));
    albedo = min(pow(texel, vec3(2.2)), vec3(0.9));
    n = normalize(normal.xyz);
    return true;
}
// `linear`: the pixel's colour before the occlusion (the albedo's; lamp light is not dimmed by ambient occlusion);
// `gs`: the same as the target holds it. Returns the street lamps' light (the lights with the street-lamp profile:
// what GT4's baked lamp light stands for, so what may replace it, N3) and gives the other lights' in `others` (the
// cars' lamps, the game's own lights: added whatever GT4 baked).
vec3 nightLight(ivec2 q, ivec2 last, vec3 linear, vec3 gs, out vec3 others) {
    others = vec3(0.0);
    if (p.inset.z >= p.inset.x && all(greaterThanEqual(vec2(q), p.inset.xy)) && all(lessThanEqual(vec2(q), p.inset.zw)))
        return vec3(0.0);   // the rear-view mirror: another view (step 2: unlit)
    const float d = nightDistance(q);
    if (!(d > 0.0 && d < p.maxDistance)) return vec3(0.0);
    const vec3 P = nightPosition(q, d);
    vec3 albedo, n;
    if (!sideSurface(q, gs, albedo, n)) {
        // Without the side channels: the albedo estimated from the picture, the normal from the Z buffer.
        const float local = nightLocal(q);
        if (!(local > 0.0)) return vec3(0.0);
        albedo = clamp(linear / max(local, 1e-3) * 0.18, vec3(0.0), vec3(0.9));
        // The normal: from the nearer neighbour on each axis, towards the camera.
        const ivec2 l = max(q - ivec2(1, 0), ivec2(0)), r = min(q + ivec2(1, 0), last);
        const ivec2 u = max(q - ivec2(0, 1), ivec2(0)), b = min(q + ivec2(0, 1), last);
        const float dl = nightDistance(l), dr = nightDistance(r), du = nightDistance(u), db = nightDistance(b);
        const vec3 ex = abs(dr - d) < abs(dl - d) ? nightPosition(r, dr) - P : P - nightPosition(l, dl);
        const vec3 ey = abs(db - d) < abs(du - d) ? nightPosition(b, db) - P : P - nightPosition(u, du);
        n = normalize(cross(ex, ey));
        if (dot(n, P) > 0.0) n = -n;
    }
    // The lights: the directional ones, then the pixel's cluster.
    vec3 sum = vec3(0.0), rest = vec3(0.0);
    float strongest = 0.0;   // the strongest street lamp's light here (luminance, before the albedo)
    for (uint i = 0u; i < header.directionalCount; ++i) {
        vec3 L;
        const float a = lightAttenuation(lights[i], P, L);
        rest += lights[i].colour * a * lightDiffuse(lightProfileOf(lights[i]), dot(n, L));   // (directional: no street lamp)
    }
    const uvec2 tile = uvec2(clamp(vec2(q) / p.size * vec2(header.clustersX, header.clustersY), vec2(0.0),
                                   vec2(header.clustersX, header.clustersY) - 1.0));
    const uint slice = clusterSlice(d, header.sliceScale, header.sliceBias);
    const ClusterCell cell = cells[clusterIndex(uvec3(tile, slice), header.clustersX, header.clustersY)];
    for (uint k = 0u; k < cell.count; ++k) {
        const uint index = indices[cell.offset + k];
        // A cell's lamps are the ones whose sphere of `range` meets it, about 35 of a street's 100 for a pixel of the
        // road, of which a few reach the pixel: the others are past their range here or have the pixel outside their
        // cone (a street lamp's points down). Those are left before the rest of the light is read and its falloff,
        // cone, profile and diffuse term worked out: their light is exactly 0 (the falloff's window at and past the
        // range; the cone at and under cosOuter, tested here with 0.02 to spare), so the sums are the same to the
        // bit. (The Odin, 2026-11-11: the light pass 0.7 ms with no lamp in view, 4.1 ms with 87.)
        const vec3 away = P - lights[index].position;   // from the light to the pixel
        const float d2 = dot(away, away), range = lights[index].range;
        if (lights[index].type != kDirectional && d2 > range * range * 1.0001) continue;
        if (lights[index].type == kSpot) {
            const float scale = lights[index].spotScale;
            const float along = dot(away, lights[index].direction);
            const float edge = -lights[index].spotOffset / scale - 0.02;   // cosOuter, less the margin
            if (scale > 0.0 && edge > 0.0 && (along <= 0.0 || along * along < edge * edge * d2)) continue;
        }
        const GpuLight light = lights[index];
        vec3 L;
        const float a = lightAttenuation(light, P, L);
        const vec3 lit = light.colour * a * lightDiffuse(lightProfileOf(light), dot(n, L));
        if (lightProfileOf(light) == kProfileStreetLamp) {
            sum += lit;
            strongest = max(strongest, dot(lit, kLuma));
        } else {
            rest += lit;
        }
    }
    // Street lamps that overlap: each one's profile already gives the road its full light, so a dense row (a tunnel's,
    // lamps every few metres on both walls) added up to several times that, and the light rose and fell along the
    // road with the count (the owner, 2026-11-11: 'big spikes in brightness'). The sum is held to kLampOverlap times
    // the strongest lamp's own light here, softly: the same as the sum while that is one lamp's.
    const float total = dot(sum, kLuma);
    if (p.lampOverlap > 1.0 && total > strongest && strongest > 0.0) {
        const float room = (p.lampOverlap - 1.0) * strongest;
        sum *= (strongest + room * (1.0 - exp(-(total - strongest) / room))) / total;
    }
    others = albedo * rest;
    return albedo * sum;
}

void main() {
    const ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 last = ivec2(p.size) - 1;
    if (any(greaterThan(q, last))) return;
    const vec4 c = texelFetch(scene, q, 0);
    // Nothing to do (night on with no lamps, say): the colour exactly as it was (both images RGBA16F; the 2.2 round trip
    // is not bit-exact).
    if (p.aoStrength == 0.0 && p.grade == 0.0 && p.night == 0.0 && p.view == 0u) {
        imageStore(result, q, c);
        return;
    }
    vec3 linear = pow(max(c.rgb, vec3(0.0)), vec3(2.2));
    const vec3 unoccluded = linear;
    float aoFactor = 1.0;
    if (p.aoStrength > 0.0) {
        const float d = distanceAt(q);
        float sum = 0.0, weights = 0.0;
        for (int y = -2; y < 2; ++y)
            for (int x = -2; x < 2; ++x) {
                const ivec2 s = clamp(q + ivec2(x, y), ivec2(0), last);
                const float w = abs(distanceAt(s) - d) < 0.05 * d ? 1.0 : 0.02;
                sum += texelFetch(occlusion, s / int(p.aoStep), 0).r * w;
                weights += w;
            }
        aoFactor = mix(1.0, sum / weights, p.aoStrength);
        linear *= aoFactor;
    }
    // The lamps: after the occlusion (their light is not ambient), before the grades.
    if (p.night > 0.0 && p.skipMasked == 2.0) {
        // N3, per pixel: the scene with GT4's baked lamp light on the road (c) and without it (binding 9). Their
        // difference is what GT4 baked here; our lamps light the surface without it. The pixel gets ours where ours
        // reaches GT4's level, GT4's where ours is under half of it, and a blend between: never darker than about
        // 0.87 of GT4's (the blend's lowest, at ours about 0.79 of it), and never both. The occlusion dims GT4's
        // baked light as it dims the rest of GT4's picture, and not ours (lamp light is not ambient).
        const vec3 gsBase = texelFetch(skipMask, q, 0).rgb;
        const vec3 base = pow(max(gsBase, vec3(0.0)), vec3(2.2));
        const vec3 baked = max(unoccluded - base, vec3(0.0));
        vec3 others;
        vec3 ours = nightLight(q, last, base, gsBase, others) * p.night;   // (the street lamps': what replaces)
        const float lb = dot(baked, kLuma);
        float lo = dot(ours, kLuma);
        // Where GT4 baked lamp light, ours stays near its level: over it, softly up to kLampOverBaked times it, so a
        // stretch our lamps light doesn't stand out from the next one GT4's light still shows on.
        if (p.lampOverBaked > 1.0 && lb > 1e-5 && lo > lb) {
            const float room = (p.lampOverBaked - 1.0) * lb;
            const float held = lb + room * (1.0 - exp(-(lo - lb) / room));
            ours *= held / lo;
            lo = held;
        }
        const vec3 dimmed = baked * aoFactor;
        const vec3 light = lb > 1e-5 ? mix(dimmed, ours, smoothstep(0.5 * lb, lb, lo)) : ours;
        // (the cars' lamps and the game's other lights on top: a braking car over an amber pool adds its red, it
        // doesn't take the pool's light away)
        linear = max(linear - dimmed + light + others * p.night, vec3(0.0));
    } else if (p.night > 0.0) {
        vec3 others;
        const vec3 street = nightLight(q, last, unoccluded, c.rgb, others);
        linear += (street + others) * p.night;
    }
    if (p.grade > 0.0) {
        vec3 x = linear;
        // Vibrance: muted colours gain the most saturation.
        const float high = max(x.r, max(x.g, x.b)), low = min(x.r, min(x.g, x.b));
        const float saturation = (high - low) / (high + 1e-4);
        const float luma = dot(x, kLuma);
        x = max(mix(vec3(luma), x, 1.0 + p.vibrance * (1.0 - saturation)), vec3(0.0));
        // Contrast around middle grey (in log space), with a shoulder that keeps highlights from clipping.
        const float l = max(dot(x, kLuma), 1e-5);
        float graded = 0.18 * pow(l / 0.18, p.contrast);
        graded = graded > 0.6 ? 0.6 + (graded - 0.6) / (1.0 + (graded - 0.6) * 0.8) : graded;
        x *= graded / l;
        // Cool shadows, warm highlights.
        const float t = smoothstep(0.02, 0.5, graded);
        x *= mix(vec3(1.0 - 0.03 * p.warmth, 1.0 - 0.01 * p.warmth, 1.0 + 0.04 * p.warmth),
                 vec3(1.0 + 0.04 * p.warmth, 1.0, 1.0 - 0.04 * p.warmth), t);
        linear = mix(linear, x, p.grade);
    }
    if (p.view == 1u) linear = vec3(texelFetch(occlusion, q / int(p.aoStep), 0).r);
    if (p.view == 2u) { const float d = distanceAt(q); linear = vec3(d < 5.0 ? 1.0 : 0.0, d < 20.0 ? 1.0 : 0.0, d < 80.0 ? 1.0 : 0.0); }
    if (p.view == 4u) linear = vec3(p.skipMasked == 1.0 ? texelFetch(skipMask, q, 0).r : 0.0);   // (N3: the skip mask)
    if (p.view == 5u) {   // the lamps the pixel's cell holds (the light loop's length), 64 = white; 0 without geometry
        const float d = nightDistance(q);
        float n = 0.0;
        if (p.night > 0.0 && d > 0.0 && d < p.maxDistance) {
            const uvec2 tile = uvec2(clamp(vec2(q) / p.size * vec2(header.clustersX, header.clustersY), vec2(0.0),
                                           vec2(header.clustersX, header.clustersY) - 1.0));
            n = float(cells[clusterIndex(uvec3(tile, clusterSlice(d, header.sliceScale, header.sliceBias)), header.clustersX,
                                         header.clustersY)].count);
        }
        linear = vec3(pow(n / 64.0, 2.2));
    }
    imageStore(result, q, vec4(pow(linear, vec3(1.0 / 2.2)), c.a));
}
