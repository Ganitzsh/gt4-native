#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// Custom MSAA resolve. Colour samples are averaged after a reversible tonemap (Karis 2013; Pettineo 2012,
// "MSAA Resolve Filters") so a bright sample cannot dominate an edge; depth keeps the nearest sample
// (reverse Z: the largest value) and the motion vector comes from that same sample.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2DMS colorSamples;
layout(set = 0, binding = 1) uniform sampler2DMS velocitySamples;
layout(set = 0, binding = 2) uniform sampler2DMS depthSamples;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D outColor;
layout(set = 0, binding = 4, rg16f) uniform writeonly image2D outVelocity;
layout(set = 0, binding = 5, r32f) uniform writeonly image2D outDepth;
layout(push_constant) uniform Push { ivec2 size; int samples; } push;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, push.size))) return;
    vec3 sum = vec3(0.0);
    float nearest = -1.0;
    int nearestSample = 0;
    for (int s = 0; s < push.samples; ++s) {
        sum += tonemapWeight(texelFetch(colorSamples, p, s).rgb);
        float depth = texelFetch(depthSamples, p, s).r;
        if (depth > nearest) { nearest = depth; nearestSample = s; }
    }
    imageStore(outColor, p, vec4(tonemapWeightInverse(sum / float(push.samples)), 1.0));
    imageStore(outVelocity, p, vec4(texelFetch(velocitySamples, p, nearestSample).rg, 0.0, 0.0));
    imageStore(outDepth, p, vec4(nearest));
}
