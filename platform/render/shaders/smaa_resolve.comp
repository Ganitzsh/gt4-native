#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// SMAA T2x temporal resolve (SMAAResolvePS with SMAA_REPROJECTION): blends the two jittered frames,
// reprojecting the previous one with the motion vectors and fading it out where velocities differ.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D current;    // sRGB-encoded, a = sqrt(5 |velocity|)
layout(set = 0, binding = 1) uniform sampler2D previous;   // last resolve input (same format), linear clamp
layout(set = 0, binding = 2) uniform sampler2D velocityTex;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D target;
layout(push_constant) uniform Push { ivec2 size; float reset; } push;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, push.size))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(push.size);
    vec4 c = texelFetch(current, p, 0);
    if (push.reset > 0.5) { imageStore(target, p, c); return; }
    vec2 previousUv = uv + textureLod(velocityTex, uv, 0.0).rg;
    vec4 h = textureLod(previous, previousUv, 0.0);
    float delta = abs(c.a * c.a - h.a * h.a) / 5.0;
    float weight = 0.5 * clamp(1.0 - sqrt(delta) * 30.0, 0.0, 1.0);
    if (any(lessThan(previousUv, vec2(0.0))) || any(greaterThan(previousUv, vec2(1.0)))) weight = 0.0;
    vec3 linear = mix(srgbDecode(c.rgb), srgbDecode(h.rgb), weight);
    imageStore(target, p, vec4(srgbEncode(linear), c.a));
}
