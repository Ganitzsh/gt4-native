#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "dof.glsl"
// Blends the sharp image with the upsampled bokeh by the full-resolution circle of confusion.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D sharp;
layout(set = 0, binding = 1) uniform sampler2D blurred;   // half resolution, linear clamp; a = |CoC| (half px)
layout(set = 0, binding = 2) uniform sampler2D depth;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D target;
layout(push_constant) uniform Push {
    ivec2 size; float near; float focusDistance; float focalLength; float aperture; float sensorHeight;
    float maxCoc; float autofocus;
} push;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, push.size))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(push.size);
    DofParams params = DofParams(push.near, push.focusDistance, push.focalLength, push.aperture, push.sensorHeight,
                                 float(push.size.y), push.maxCoc * 2.0);
    if (push.autofocus > 0.5) {
        float sum = textureLod(depth, vec2(0.5), 0.0).r + textureLod(depth, vec2(0.48, 0.5), 0.0).r +
                    textureLod(depth, vec2(0.52, 0.5), 0.0).r + textureLod(depth, vec2(0.5, 0.47), 0.0).r +
                    textureLod(depth, vec2(0.5, 0.53), 0.0).r;
        params.focusDistance = linearDepth(sum / 5.0, push.near);
    }
    float coc = abs(circleOfConfusion(linearDepth(textureLod(depth, uv, 0.0).r, push.near), params));
    vec4 bokeh = textureLod(blurred, uv, 0.0);
    // Foreground blur also spreads over in-focus pixels: use the larger of the two CoCs.
    float blend = smoothstep(0.5, 2.5, max(coc, bokeh.a * 2.0));
    vec3 c = mix(texelFetch(sharp, p, 0).rgb, bokeh.rgb, blend);
    imageStore(target, p, vec4(c, 1.0));
}
