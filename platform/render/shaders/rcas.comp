#version 460
#extension GL_GOOGLE_include_directive : require
// AMD FidelityFX RCAS (Robust Contrast Adaptive Sharpening) from the vendored FSR headers (MIT).
#define FFX_GPU 1
#define FFX_GLSL 1
#define FFX_HALF 0
#include "fidelityfx-fsr2/shaders/ffx_core.h"
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D target;
layout(push_constant) uniform Push { uvec4 con; ivec2 size; } push;
#define FSR_RCAS_F 1
FfxFloat32x4 FsrRcasLoadF(FfxInt32x2 p) { return texelFetch(source, clamp(p, ivec2(0), push.size - 1), 0); }
void FsrRcasInputF(inout FfxFloat32 r, inout FfxFloat32 g, inout FfxFloat32 b) {}
#include "fidelityfx-fsr2/shaders/ffx_fsr1.h"

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, uvec2(push.size)))) return;
    FfxFloat32 r, g, b;
    FsrRcasF(r, g, b, p, push.con);
    imageStore(target, ivec2(p), vec4(r, g, b, 1.0));
}
