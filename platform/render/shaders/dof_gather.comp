#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
// Scatter-as-gather bokeh on a golden-angle spiral (Gustafsson 2018, "Bokeh depth of field in a single
// pass"): every sample whose own CoC reaches this pixel contributes, background samples are limited to
// twice the centre CoC so sharp foreground does not bleed into a blurred background.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D source;   // half resolution, rgb + signed CoC (pixels)
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D target;
layout(push_constant) uniform Push { ivec2 size; float radiusScale; float maxCoc; } push;
const float GOLDEN_ANGLE = 2.39996323;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, push.size))) return;
    vec2 texel = 1.0 / vec2(push.size);
    vec2 uv = (vec2(p) + 0.5) * texel;
    vec4 center = textureLod(source, uv, 0.0);
    float centerSize = abs(center.a);
    vec3 color = center.rgb;
    float total = 1.0;
    float radius = push.radiusScale;
    for (float angle = 0.0; radius < push.maxCoc; angle += GOLDEN_ANGLE) {
        vec4 s = textureLod(source, uv + vec2(cos(angle), sin(angle)) * texel * radius, 0.0);
        float sampleSize = abs(s.a);
        // A sample behind the centre (larger depth, positive CoC beyond it) cannot cover a sharper foreground.
        if (s.a > center.a) sampleSize = clamp(sampleSize, 0.0, centerSize * 2.0);
        float m = smoothstep(radius - 0.5, radius + 0.5, sampleSize);
        color += mix(color / total, s.rgb, m);
        total += 1.0;
        radius += push.radiusScale / radius;
    }
    imageStore(target, p, vec4(color / total, centerSize));
}
