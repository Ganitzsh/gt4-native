#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "cube.glsl"
// GGX prefiltered environment map (Karis 2013, "Real Shading in Unreal Engine 4"), with the
// PDF-based source mip selection of Krivanek & Colbert 2008 to avoid sampling noise.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform samplerCube source;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray target;
layout(push_constant) uniform Push { float size; float roughness; float sourceSize; uint samples; } push;

vec2 hammersley(uint i, uint n) {
    uint bits = bitfieldReverse(i);
    return vec2(float(i) / float(n), float(bits) * 2.3283064365386963e-10);
}

vec3 importanceSampleGgx(vec2 xi, float a, vec3 n) {
    float phi = 2.0 * PI * xi.x;
    float cosTheta = clamp(sqrt((1.0 - xi.y) / max(1.0 + (a * a - 1.0) * xi.y, 1e-7)), 0.0, 1.0);
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));   // rounding can make cos^2 exceed 1
    vec3 h = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
    vec3 up = abs(n.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tx = normalize(cross(up, n));
    vec3 ty = cross(n, tx);
    return normalize(tx * h.x + ty * h.y + n * h.z);
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (id.x >= uint(push.size) || id.y >= uint(push.size)) return;
    vec3 n = cubeDirection(id.z, vec2(id.xy), push.size);
    if (push.roughness == 0.0) {
        // Mirror mip: a copy of the source.
        imageStore(target, ivec3(id), vec4(textureLod(source, n, 0.0).rgb, 1.0));
        return;
    }
    float a = max(push.roughness * push.roughness, 1e-3);
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    float texelSolidAngle = 4.0 * PI / (6.0 * push.sourceSize * push.sourceSize);
    for (uint i = 0u; i < push.samples; ++i) {
        vec3 h = importanceSampleGgx(hammersley(i, push.samples), a, n);
        vec3 l = reflect(-n, h);
        float nl = dot(n, l);
        if (nl <= 0.0) continue;
        float nh = max(dot(n, h), 0.0);
        float d = a * a / (PI * pow(nh * nh * (a * a - 1.0) + 1.0, 2.0));
        float pdf = d * 0.25;  // D * NdotH / (4 VdotH) with N = V
        float sampleSolidAngle = 1.0 / (float(push.samples) * pdf + 1e-6);
        float lod = push.roughness == 0.0 ? 0.0 : max(0.5 * log2(sampleSolidAngle / texelSolidAngle) + 1.0, 0.0);
        sum += textureLod(source, l, lod).rgb * nl;
        weight += nl;
    }
    imageStore(target, ivec3(id), vec4(sum / max(weight, 1e-4), 1.0));
}
