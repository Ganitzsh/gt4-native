# Writes a file's bytes as a C++ array: cmake -DIN=<file> -DOUT=<header> -DNAME=<identifier> -P EmbedFile.cmake
# (cmake/Host.cmake embeds the UI fonts in gt4_host with it, so a release needs no assets folder beside the program).
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" length)
math(EXPR size "${length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# 8 bytes a line
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\\1\n" bytes "${bytes}")
file(WRITE "${OUT}" "// Generated by cmake/EmbedFile.cmake from ${IN}.\nalignas(4) static const unsigned char ${NAME}[${size}] = {\n${bytes}};\n")
