+// R10 spike (local, never committed): GT4_R10_BATCHES=FILE,FIRST,LAST logs, for VBlanks FIRST..LAST, one line per
+// 3D batch: its constant writes (qword, count, FNV hash of the words) and its model packets (source, qwords, hash).
+namespace r10b {
+struct Log {
+    FILE* f = nullptr;
+    unsigned long long first = 0, last = 0, run = 0;
+    std::string items;
+    Log() {
+        const char* e = std::getenv("GT4_R10_BATCHES");
+        if (!e) return;
+        char path[512] = {};
+        if (std::sscanf(e, "%511[^,],%llu,%llu", path, &first, &last) == 3) f = std::fopen(path, "w");
+    }
+    bool on(uint64_t vblank) const { return f && vblank >= first && vblank <= last; }
+};
+inline Log& log() { static Log l; return l; }
+// GT4_R10_HOLD=FROM,TO,QLO,QHI (ablation): writes touching qwords QLO..QHI are applied at the batch's run instead
+// of at once; for VBlanks FROM..TO each batch (keyed by its model packets' sources, and its place among batches
+// with the same packets) gets the values it last had before FROM.
+struct Hold {
+    bool on = false;
+    unsigned long long from = 0, to = 0;
+    unsigned qlo = 0, qhi = 0;
+    struct W { uint16_t qword, count; uint32_t lanes; std::vector<uint32_t> words; };
+    std::vector<W> pending;                       // this batch's postponed writes
+    std::string key;                              // this batch's packet sources
+    std::map<std::string, unsigned> seen;         // this frame: batches per key so far
+    std::map<std::string, std::vector<W>> saved;  // key#n -> the writes it had before FROM
+    unsigned long long held = 0;
+    Hold() {
+        const char* e = std::getenv("GT4_R10_HOLD");
+        if (e && std::sscanf(e, "%llu,%llu,%u,%u", &from, &to, &qlo, &qhi) == 4) on = true;
+        if (const char* f = std::getenv("GT4_R10_HOLD_SOURCES")) {
+            std::string t(f);
+            size_t a = 0;
+            while (a < t.size()) {
+                size_t b = t.find(',', a);
+                if (b == std::string::npos) b = t.size();
+                if (b > a) only.push_back(std::to_string(std::strtoull(t.substr(a, b - a).c_str(), nullptr, 16)));
+                a = b + 1;
+            }
+        }
+    }
+    std::vector<std::string> only;                // decimal sources; empty = every batch
+    bool match(const std::string& k) const {
+        if (only.empty()) return true;
+        size_t a = 0;
+        while (a < k.size()) {
+            size_t b = k.find(',', a);
+            if (b == std::string::npos) b = k.size();
+            const std::string tok = k.substr(a, b - a);
+            for (const auto& o : only)
+                if (o == tok) return true;
+            a = b + 1;
+        }
+        return false;
+    }
+    bool touches(unsigned q, unsigned n) const { return on && q <= qhi && q + n > qlo; }
+};
+inline Hold& hold() { static Hold h; return h; }
+inline uint64_t fnv(const void* p, size_t n) {
+    uint64_t h = 1469598103934665603ull;
+    for (size_t i = 0; i < n; ++i) h = (h ^ static_cast<const uint8_t*>(p)[i]) * 1099511628211ull;
+    return h;
+}
