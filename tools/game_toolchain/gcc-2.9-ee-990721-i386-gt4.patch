diff --git a/gcc/config/i386/gt4-native.h b/gcc/config/i386/gt4-native.h
new file mode 100755
index 0000000..eee386a
--- /dev/null
+++ b/gcc/config/i386/gt4-native.h
@@ -0,0 +1,93 @@
+/* GT4 native port: the i386 PE-COFF (mingw32) target with the PS2 Emotion Engine's data model.
+
+   The game's decompiled sources were written for Sony's ee-gcc 2.96 (MIPS R5900, EABI, 32-bit
+   pointers, 64-bit long).  The native program maps the original game image at its original
+   addresses, so code compiled here must see every object with the EE's sizes, offsets and
+   alignments.  This header is included last (after mingw32.h and crtdll.h) and changes only the
+   data model and the predefined macros; code generation stays the stock i386 back end (x87
+   floating point, cdecl, 32-bit pointers).  */
+
+/* long is 64-bit on the EE (ee-gcc: sizeof (long) == 8, __alignof__ (long) == 8).  It is a
+   DImode integer here, handled like long long.  int, size_t, ptrdiff_t and pointers stay 32-bit.  */
+#undef LONG_TYPE_SIZE
+#define LONG_TYPE_SIZE 64
+#undef MAX_LONG_TYPE_SIZE
+#define MAX_LONG_TYPE_SIZE 64
+
+/* long double is the EE's 64-bit double, not the x87 96-bit extended type.  */
+#undef LONG_DOUBLE_TYPE_SIZE
+#define LONG_DOUBLE_TYPE_SIZE 64
+
+/* i386.h ties the x87 registers' XFmode to LONG_DOUBLE_TYPE_SIZE == 96; the back end still uses
+   XFmode internally, so keep the registers able to hold it.  */
+#undef HARD_REGNO_MODE_OK
+#define HARD_REGNO_MODE_OK(REGNO, MODE) \
+  ((REGNO) < 4 ? 1						\
+   : FP_REGNO_P (REGNO)						\
+   ? (((int) GET_MODE_CLASS (MODE) == (int) MODE_FLOAT		\
+       || (int) GET_MODE_CLASS (MODE) == (int) MODE_COMPLEX_FLOAT)	\
+      && GET_MODE_UNIT_SIZE (MODE) <= 12)			\
+   : (int) (MODE) != (int) QImode ? 1				\
+   : (reload_in_progress | reload_completed) == 1)
+
+/* bool is a 32-bit int as on the EE (cp/decl.c sizes it by SLOW_BYTE_ACCESS, which MIPS sets and
+   i386 does not): sizeof (bool) == 4, and so are the classes that hold one.  */
+#undef BOOL_TYPE_SIZE
+#define BOOL_TYPE_SIZE 32
+
+/* wchar_t is the EE's: a signed 32-bit int (mingw: unsigned short).  */
+#undef WCHAR_TYPE
+#define WCHAR_TYPE "int"
+#undef WCHAR_TYPE_SIZE
+#define WCHAR_TYPE_SIZE 32
+#undef WCHAR_UNSIGNED
+#define WCHAR_UNSIGNED 0
+
+/* 64-bit types (long, long long, double) are 8-aligned in structures as on the EE: cygwin.h's
+   BIGGEST_ALIGNMENT of 128 already gives DImode and DFmode their natural 64-bit alignment (the
+   stock i386 targets cap it at 32).  Stated here so the dependency is explicit.  */
+#undef BIGGEST_ALIGNMENT
+#define BIGGEST_ALIGNMENT 128
+
+/* No Windows macros: the game's sources (expat, newlib, libio) would take their Win32 paths.
+   __GT4_NATIVE__ marks this compiler; __LONG_MAX__ is what ee-gcc's driver defines.  */
+#undef CPP_PREDEFINES
+#define CPP_PREDEFINES "-Di386 -D__GT4_NATIVE__ -D__LONG_MAX__=9223372036854775807L \
+  -D__stdcall=__attribute__((__stdcall__)) \
+  -D__cdecl=__attribute__((__cdecl__)) \
+  -Asystem(gt4) -Acpu(i386) -Amachine(i386)"
+
+/* No cygwin/mingw include remapping: the game code is freestanding.  */
+#undef CPP_SPEC
+/* __GNUC_MINOR__ is ee-gcc 2.96's (the sources and the SGI STL test it), not this 2.9 snapshot's
+   9: the driver's -D__GNUC_MINOR__=9 comes first and cpp applies -U/-D in order.  */
+#define CPP_SPEC "%(cpp_cpu) -U__GNUC_MINOR__ -D__GNUC_MINOR__=96"
+
+/* Asm labels (`int f () __asm__ ("func_00330900");`) get the `_' user label prefix like any C
+   name (varasm.c make_decl_rtl, patched): the decomp names one game function by asm label in one
+   source and by its C name in another, which on the EE (no prefix) is one symbol.  */
+#define ASMSPEC_USER_LABEL_PREFIX 1
+
+/* Every call reserves 32 bytes above its pushed arguments (calls.c): the decomp declares many
+   functions with more parameters than their callers pass, harmless on the EE (they are registers,
+   with a home area) but here the callee would write its extra parameter slots into the caller's
+   frame.  The callee's view is the usual cdecl one ([esp+4] = first argument).  */
+#define GT4_CALL_PAD 32
+
+/* Arguments passed by invisible reference as on the EE (abi64.h, mips.c function_arg_pass_by_reference,
+   EABI): an aggregate larger than 8 bytes, or of variable size, is passed as the address of the
+   caller's object, and the callee copies a named one before changing it.  128-bit values (TImode:
+   16 bytes, 16-aligned, the EE's 128-bit integers) stay by value, as the r5900 passes them in one
+   register.  The decomp's sources rely on it: a caller passes `&tmp' where the callee's definition
+   takes the 12-byte value itself (the STL heap and sort instantiations, 00607A80 and others), which
+   on the EE is the same call; copied onto the stack by value here, the callee read the pointer and
+   whatever followed it as the value.  */
+#define GT4_PASS_BY_REFERENCE(TYPE) \
+  ((TYPE) != 0 \
+   && (int_size_in_bytes (TYPE) == -1 \
+       || (int_size_in_bytes (TYPE) > 8 \
+	   && ! (int_size_in_bytes (TYPE) == 16 && TYPE_ALIGN (TYPE) >= 128))))
+#undef FUNCTION_ARG_PASS_BY_REFERENCE
+#define FUNCTION_ARG_PASS_BY_REFERENCE(CUM, MODE, TYPE, NAMED) GT4_PASS_BY_REFERENCE (TYPE)
+#undef FUNCTION_ARG_CALLEE_COPIES
+#define FUNCTION_ARG_CALLEE_COPIES(CUM, MODE, TYPE, NAMED) ((NAMED) && GT4_PASS_BY_REFERENCE (TYPE))
